# Application Environment
NODE_ENV=development
PORT=3000
GLOBAL_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:4200

# MongoDB Replica Set (rs0)
MONGODB_URI=mongodb://127.0.0.1:27017/gigahub?replicaSet=rs0&directConnection=true

# Redis Cache & Events
REDIS_URL=redis://localhost:6379

# MinIO Object Storage
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=gigahub

# Auth / JWT (ES256). Leave empty in development to use built-in dev keys.
JWT_ISSUER=gigahub
JWT_AUDIENCE=gigahub-web
JWT_ACCESS_TTL_SECONDS=900
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----"
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\\n...\\n-----END PUBLIC KEY-----"
AUTH_COOKIE_NAME=gh_refresh
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax

# IXC MySQL (user sync on boot + every 5 min, and live password auth).
# Sync runs whenever IXC_DB_USER is set. Users are not seeded.
IXC_DB_HOST=127.0.0.1
IXC_DB_PORT=3306
IXC_DB_USER=
IXC_DB_PASS=
IXC_DB_NAME=ixcprovedor
