# Copy to secret-api.yaml (gitignored) or create via:
#   kubectl -n gigahub create secret generic api-secrets --from-env-file=deploy/k8s/api-secrets.env
#
# Do not commit real credentials.
apiVersion: v1
kind: Secret
metadata:
  name: api-secrets
  namespace: gigahub
type: Opaque
stringData:
  MONGODB_URI: mongodb://mongo:27017/gigahub?replicaSet=rs0&directConnection=true
  REDIS_URL: redis://redis:6379
  MINIO_ENDPOINT: minio.storage.svc.cluster.local
  MINIO_ACCESS_KEY: gigahub
  MINIO_SECRET_KEY: change-me-minio-user-secret
  # Public URL via Cloudflare Tunnel + Ingress
  CORS_ORIGIN: https://hub.giganet.dev.br
  # ES256 PEMs — escape newlines as \n in a single line
  JWT_PRIVATE_KEY: "-----BEGIN PRIVATE KEY-----\nCHANGE_ME\n-----END PRIVATE KEY-----"
  JWT_PUBLIC_KEY: "-----BEGIN PUBLIC KEY-----\nCHANGE_ME\n-----END PUBLIC KEY-----"
  IXC_DB_HOST: 10.254.4.50
  IXC_DB_USER: ""
  IXC_DB_PASS: ""
  AUTH_BOOTSTRAP_ADMIN_ERP_IDS: ""
