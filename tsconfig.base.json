{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "ignoreDeprecations": "6.0",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2022",
    "module": "esnext",
    "lib": ["es2022", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": true,
    "paths": {
      "@gigahub/shared/contracts": ["./libs/shared/contracts/src/index.ts"],
      "@shared/contracts": ["./libs/shared/contracts/src/index.ts"],
      "@gigahub/shared/config": ["./libs/shared/config/src/index.ts"],
      "@shared/config": ["./libs/shared/config/src/index.ts"],
      "@gigahub/shared/tsconfig": ["./libs/shared/tsconfig/src/index.ts"],
      "@shared/tsconfig": ["./libs/shared/tsconfig/src/index.ts"],
      "@gigahub/shared/kernel": ["./libs/shared/kernel/src/index.ts"],
      "@shared/kernel": ["./libs/shared/kernel/src/index.ts"],
      "@gigahub/domain/customer": ["./libs/domain/customer/src/index.ts"],
      "@shared/domain/customer": ["./libs/domain/customer/src/index.ts"],
      "@gigahub/domain/work-order": ["./libs/domain/work-order/src/index.ts"],
      "@shared/domain/work-order": ["./libs/domain/work-order/src/index.ts"],
      "@gigahub/domain/demand": ["./libs/domain/demand/src/index.ts"],
      "@shared/domain/demand": ["./libs/domain/demand/src/index.ts"],
      "@gigahub/domain/fiber-access-terminal": [
        "./libs/domain/fiber-access-terminal/src/index.ts"
      ],
      "@shared/domain/fiber-access-terminal": [
        "./libs/domain/fiber-access-terminal/src/index.ts"
      ],
      "@gigahub/domain/fiber-cable": [
        "./libs/domain/fiber-cable/src/index.ts"
      ],
      "@shared/domain/fiber-cable": [
        "./libs/domain/fiber-cable/src/index.ts"
      ],
      "@gigahub/domain/identity": ["./libs/domain/identity/src/index.ts"],
      "@shared/domain/identity": ["./libs/domain/identity/src/index.ts"],
      "@gigahub/application-identity": [
        "./libs/application-identity/src/index.ts"
      ],
      "@shared/application-identity": [
        "./libs/application-identity/src/index.ts"
      ],
      "@gigahub/application-demand": [
        "./libs/application-demand/src/index.ts"
      ],
      "@shared/application-demand": [
        "./libs/application-demand/src/index.ts"
      ],
      "@gigahub/application-network": [
        "./libs/application-network/src/index.ts"
      ],
      "@shared/application-network": [
        "./libs/application-network/src/index.ts"
      ],
      "@gigahub/application-customer": [
        "./libs/application-customer/src/index.ts"
      ],
      "@shared/application-customer": [
        "./libs/application-customer/src/index.ts"
      ],
      "@gigahub/adapters-ixc": ["./libs/adapters-ixc/src/index.ts"],
      "@shared/adapters-ixc": ["./libs/adapters-ixc/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
